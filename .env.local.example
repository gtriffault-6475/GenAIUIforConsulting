# Read only server-side, by `skills/buildRequest.ts` (AD-11, the sole
# `@anthropic-ai/sdk` assembly point) via `process.env` — never exposed to
# the client. Copy this file to `.env.local` (already gitignored) and set
# a real key to enable sending messages from the workspace composer.
ANTHROPIC_API_KEY=

# Mode démo scripté (spec-mode-demo-scripte.md) — set to exactly `true` to
# make `skills/buildRequest.ts`'s `sendToAgent` return pre-written
# ("canned") replies instead of calling the real Anthropic API above, so
# the app stays demoable with no `ANTHROPIC_API_KEY` set. Read only via
# `skills/demoScript.ts`'s `isDemoModeActive()` — never toggles on its own
# just because `ANTHROPIC_API_KEY` above is empty. Leave unset (or `false`)
# for a real deployment: a missing/invalid key there must stay a visible
# failure, never silently look like a feature.
DEMO_MODE=
