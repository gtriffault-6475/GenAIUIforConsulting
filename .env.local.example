# Read only server-side, by `skills/buildRequest.ts` (AD-11, the sole
# `@anthropic-ai/sdk` assembly point) via `process.env` — never exposed to
# the client. Copy this file to `.env.local` (already gitignored) and set
# a real key to enable sending messages from the workspace composer.
#
# The scripted demo mode (spec-mode-demo-scripte.md) no longer needs a
# `DEMO_MODE` variable here: spec-toggle-mode-demo-ui.md moved its
# activation to a toggle button in the app itself (persisted on
# `APP_STATE.demoModeActive`, `actions/demo.ts`) — no `.env.local` edit or
# server restart needed to demo without this key set.
ANTHROPIC_API_KEY=

# Epic 5 — Google Drive (see README "Google Drive (Epic 5)" for the Google
# Cloud setup). Read only server-side by `actions/google-connection.ts`.
# Leave any of the three empty and the app runs without Google: no drive
# files outside demo mode, no "Connecter Google Drive" button. OAuth
# consent screen user type "Internal"; OAuth client of type "Web
# application" with the redirect URI
# http://localhost:3000/api/google/oauth/callback — so open the app at
# exactly http://localhost:3000 (not 127.0.0.1, not another port).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID of the Drive folder containing one sub-folder per project, named
# exactly like the project (last segment of the folder's URL).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
